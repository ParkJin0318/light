{
  "name": "@light/mac",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "tokens": "cp ../pwa/src/styles/tokens.css ui/tokens.css",
    "build": "npm run tokens && tsc -p .",
    "start": "npm run tokens && tsc -p . && electron ."
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  },
  "version": "0.1.0",
  "description": "light — Mac 의 Claude Code 세션을 폰에서 다루는 메뉴바 앱",
  "build": {
    "productName": "light",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "ui/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.build/light-daemon",
        "to": "light-daemon"
      },
      {
        "from": "../pwa/dist",
        "to": "pwa"
      },
      {
        "from": "../.build/build.json",
        "to": "build.json"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon-512.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/light-daemon"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "author": "Jin"
}
